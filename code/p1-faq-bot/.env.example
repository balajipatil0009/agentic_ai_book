# Copy to .env and fill in. NEVER commit .env.

# --- Database (PostgreSQL + pgvector, see docker-compose.yml) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/faqbot

# --- API auth: the /ask endpoint requires this exact value in X-API-Key ---
API_KEY=change-me-to-a-long-random-string

# --- Chat provider: openai | anthropic | ollama ---
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...        # only if CHAT_PROVIDER=anthropic
# OPENAI_API_KEY=sk-...               # if any provider is openai
# OLLAMA_BASE_URL=http://localhost:11434   # if any provider is ollama

# --- Embeddings provider: openai | voyage | ollama ---
# NOTE: every vector in pgvector must have the same dimension.
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# For a fully local setup use Ollama instead:
#   EMBEDDINGS_PROVIDER=ollama
#   EMBEDDINGS_MODEL=nomic-embed-text
#   EMBEDDING_DIM=768
